# Firebase Environment Variables (example)
# Copy this to .env and fill in your actual values from the Firebase Console

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Office-to-PDF conversion is handled by the Netlify function (netlify/functions/office-to-pdf.mts).
# No API key required — conversion runs locally using mammoth + xlsx + chromium.

# ─── Firebase Admin SDK (server-side only — Netlify Functions) ────────────
# Required by: office-to-pdf.mts, compress-pdf.mts, bulk-create-users.mts,
#              cleanup-corrupted-nominations.mts, merge-corrupted-nominations.mts
# Value: base64-encode your Firebase service account JSON key, e.g.:
#   Windows (PowerShell): [Convert]::ToBase64String([IO.File]::ReadAllBytes("serviceAccount.json"))
#   macOS/Linux:           base64 -w 0 serviceAccount.json
# ⚠️  DO NOT commit the real value to version control!
# In Netlify: Site settings → Environment variables → add FIREBASE_ADMIN_SDK_B64,
# with "Functions" checked under Scopes (and all deploy contexts you use), or via:
#   netlify env:set FIREBASE_ADMIN_SDK_B64 "$(cat serviceAccount.json | base64 -w 0)"
FIREBASE_ADMIN_SDK_B64=

# Optional override — defaults to "<project-id>.appspot.com" if unset.
FIREBASE_STORAGE_BUCKET=

# ─── EmailJS (server-side — Netlify Functions) ────────────────────────────
# Used by the send-* functions and bulk-create-users. Keys and service id:
# https://dashboard.emailjs.com/admin/account and Email Services.
# In Netlify, scope these to Functions like FIREBASE_ADMIN_SDK_B64. Links in the
# emails use Netlify's built-in URL variable, so no site address is needed here.
VITE_EMAILJS_PUBLIC_KEY=
# ⚠️  Private key — never prefix with VITE_ (that would ship it to browsers).
EMAILJS_PRIVATE_KEY=
VITE_EMAILJS_SERVICE_ID=

# Template ids (EmailJS → Email Templates). The {{variables}} each template can use:
# Incomplete-nomination reminders (nominator & nominee):
#   to_email, nominator_name, nominee_name, category_name, incomplete_items,
#   incomplete_items_html, submission_url, current_year
VITE_EMAILJS_TEMPLATE_ID=
# Shortlisted nominee notice:
#   to_email, nominee_name, nominator_name, category_name, submission_url, current_year
VITE_EMAILJS_SHORTLIST_TEMPLATE_ID=
# Adjudication closed notice:
#   to_email, recipient_name, recipient_type, sender_name, sender_email, closure_date, current_year
VITE_EMAILJS_CLOSURE_TEMPLATE_ID=
# "Finish your scoring" alert (admin panel → Alert Judge):
#   to_email, incomplete_count, nominee_list, judge_url, current_year
VITE_EMAILJS_JUDGE_ALERT_TEMPLATE_ID=
# Nominator's receipt, sent once after a nomination is submitted:
#   to_email, nominator_name, nominee_name, category_name, reference, site_url, current_year
VITE_EMAILJS_CONFIRMATION_TEMPLATE_ID=
# Admin/judge account invitations use a template with the fixed id "template_bulk_invite":
#   to_email, to_name, user_role, reset_link, support_email
